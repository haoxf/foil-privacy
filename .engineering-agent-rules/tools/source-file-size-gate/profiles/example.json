{
  "schema_version": 1,
  "source_roots": [
    "."
  ],
  "include_globs": [
    "*.py",
    "**/*.py",
    "*.c",
    "**/*.c",
    "*.cc",
    "**/*.cc",
    "*.cpp",
    "**/*.cpp",
    "*.cxx",
    "**/*.cxx",
    "*.h",
    "**/*.h",
    "*.hh",
    "**/*.hh",
    "*.hpp",
    "**/*.hpp",
    "*.hxx",
    "**/*.hxx"
  ],
  "exclude_globs": [
    ".engineering-agent-rules/**",
    ".git/**",
    ".toolchain/**",
    ".build/**",
    ".swiftpm/**",
    ".evidence/**",
    "**/DerivedData/**",
    "**/.xcode-derived-data/**",
    "**/node_modules/**",
    "**/__pycache__/**",
    "**/Generated/**",
    "**/generated/**",
    "**/*.generated.*",
    "**/*_generated.*"
  ],
  "allowlist_path": "Docs/source-file-size-allowlist.json",
  "threshold": 1000
}
